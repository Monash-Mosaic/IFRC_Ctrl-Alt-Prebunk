{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/*.test.ts",
      "!!**/*.test.tsx",
      "!!**/*.spec.ts",
      "!!**/*.spec.tsx",
      "!!**/__tests__",
      "!!coverage",
      "!!jest.config.js",
      "!!jest.setup.js",
      "!!postcss.config.mjs",
      "!!src/test-utils",
      "!!.next",
      "!!out",
      "!!build",
      "!!next-env.d.ts",
      "!!.open-next",
      "!!cloudflare-env.d.ts"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": false
  }
}
